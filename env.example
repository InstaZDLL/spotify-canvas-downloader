# Required: copy the sp_dc cookie from an authenticated open.spotify.com session.
SP_DC=your_sp_dc_cookie_value

# Optional cookie used by some Spotify sessions.
SP_KEY=

# Local server and browser origin configuration.
BIND_ADDR=127.0.0.1:8000
HOST_ORIGIN=http://localhost:3000

# Required only by the ignored live integration test.
SPOTIFY_TEST_TRACK_ID=

# Optional emergency TOTP override. Both values must be set together.
# SPOTIFY_TOTP_VERSION=61
# SPOTIFY_TOTP_SECRET_BASE64=
